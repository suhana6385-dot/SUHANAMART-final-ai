<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SUHANAMART</display-name>

    <!--
        Servlets and filters (LoginServlet, RegisterServlet,
        ProductServlet, CartServlet, CheckoutServlet, LogoutServlet,
        ReviewServlet, AuthFilter, RoleFilter, EncodingFilter and the
        seller controllers) are all registered via annotations
        (@WebServlet / @WebFilter) in com.suhanamart.controller and
        com.suhanamart.filter. This works because annotation scanning
        is on by default for a Servlet 4.0 web.xml (no
        metadata-complete="true" is set here) - nothing further is
        needed in this file for them to be picked up.
    -->

    <welcome-file-list>
        <welcome-file>public/login.jsp</welcome-file>
    </welcome-file-list>

    <!--
        Friendly error pages, so a visitor never sees Tomcat's default
        error report (which includes Java stack traces for unhandled
        exceptions). public/error.jsp prints only a generic message.
    -->
    <error-page>
        <error-code>403</error-code>
        <location>/public/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/public/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/public/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/public/error.jsp</location>
    </error-page>

</web-app>
