<%-- Admin navigation. The including page must set the String variable
     "activeNav" ("dashboard", "users", "products" or "orders"). Uses the
     same markup/ids as navbar.jspf, so main.js's mobile menu toggle
     works unchanged. --%>
<header class="dash-header">
    <div class="dash-header-inner">

        <div class="dash-brand">
            <div class="brand-icon">S</div>
            <span>SUHANAMART</span>
            <span class="admin-tag">Admin</span>
        </div>

        <nav class="dash-nav" id="dashNav">
            <a href="<%= request.getContextPath() %>/admin/dashboard"
               class="<%= "dashboard".equals(activeNav) ? "active" : "" %>">Dashboard</a>
            <a href="<%= request.getContextPath() %>/admin/users"
               class="<%= "users".equals(activeNav) ? "active" : "" %>">Users</a>
            <a href="<%= request.getContextPath() %>/admin/products"
               class="<%= "products".equals(activeNav) ? "active" : "" %>">Products</a>
            <a href="<%= request.getContextPath() %>/admin/orders"
               class="<%= "orders".equals(activeNav) ? "active" : "" %>">Orders</a>
            <a href="<%= request.getContextPath() %>/LogoutServlet" class="nav-logout">Logout</a>
        </nav>

        <button type="button" class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>

    </div>
</header>
