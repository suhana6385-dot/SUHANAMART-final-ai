<%-- Helpers shared by the seller JSPs. Include this FIRST in each seller page.
     h(x)    - HTML-escapes any value (use it for EVERY piece of dynamic text)
     fmt(ts) - formats a timestamp for display --%>
<%@ page import="com.suhanamart.util.SecurityUtil" %>
<%!
    private String h(Object value) {
        return SecurityUtil.escapeHtml(value);
    }

    private String fmt(java.sql.Timestamp timestamp) {
        return timestamp == null ? "" : new java.text.SimpleDateFormat("dd MMM yyyy, HH:mm").format(timestamp);
    }
%>
